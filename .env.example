# Run npm run setup to create a private local .env with a random inbox password.
# For hosting, set these variables in your hosting service.
ADMIN_PASSWORD=
HOST=0.0.0.0
PORT=8000
NODE_ENV=production
SITE_URL=
DATA_DIR=/app/data
# Enable once the public collection and domain are ready.
ENABLE_INDEXING=false
# Set true only behind a trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
# Optional notifications; enquiries work in the private inbox without these.
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=
